FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY handler.py .
COPY tests ./tests
COPY pyproject.toml .

# Polling mode (fallback when Floci Lambda is unavailable).
# For Lambda mode, code is deployed via Terraform to Floci directly.
CMD ["python", "handler.py", "--poll"]
